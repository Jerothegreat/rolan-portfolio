# Visit counter (app/api/visits). Optional: without these the ticker shows "you are visitor #------".
# Create a free Upstash Redis database (Vercel Marketplace or upstash.com) and copy its REST credentials.
# The Vercel integration names them KV_REST_API_URL / KV_REST_API_TOKEN; either pair works.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
