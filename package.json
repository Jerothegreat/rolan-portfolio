{
  "name": "1mil-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web exec tsc --noEmit",
    "lint": "pnpm --filter web lint",
    "check:workspace": "pnpm typecheck && pnpm lint && pnpm build"
  }
}
